# MySQL used by the screen aggregation API
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_register
DB_USER=user
DB_PASSWORD=pass

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8000
APP_URL=http://localhost:3000
API_PORT=8000

# Optional seed overrides (used by `bun run seed:users`)
# SEED_YEAR=2026
# SEED_STAFF_EMAIL=staff@example.com
# SEED_STAFF_PASSWORD=Staff123!
# SEED_TEACHER_EMAIL=teacher@example.com
# SEED_TEACHER_PASSWORD=Teacher123!
# SEED_RESET_PASSWORD=1
